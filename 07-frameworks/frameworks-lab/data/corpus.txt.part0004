    int ldb, int ldc, int blocksize, cudaStream_t stream
) {
    gemm_4bit_inference_naive<bnb_bfloat16, 16>(m, n, k, A, B, absmax, datatype, out, lda, ldb, ldc, blocksize, stream);
}

