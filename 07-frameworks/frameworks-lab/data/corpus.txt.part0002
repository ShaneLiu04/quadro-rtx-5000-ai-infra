            # but any other value is invalid since Adam8bit always uses 8-bit optimization
            raise ValueError("Adam8bit only supports optim_bits=32 (default value for compatibility)")

        super().__init__(
            "adam",
            params,
            lr,
            betas,
            eps,
            weight_decay,
            8,  # Hardcoded to 8 bits
            args,
            min_8bit_size,
            is_paged=is_paged,
        )


